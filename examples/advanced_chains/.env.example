# ============================================================================
# Advanced LangChain Examples - Environment Configuration Template
# ============================================================================
#
# PURPOSE:
#   This file provides a template for configuring environment variables
#   required by the advanced LangChain chain examples in this directory.
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to `.env` in the same directory:
#      cp .env.example .env
#   
#   2. Replace placeholder values with your actual API keys and configuration
#   
#   3. Obtain API keys from the following sources:
#      - OpenAI: https://platform.openai.com/account/api-keys
#      - Anthropic: https://console.anthropic.com/account/keys
#      - LangSmith (optional): https://smith.langchain.com/settings
#
# SECURITY WARNING:
#   ⚠️  NEVER commit your .env file to version control!
#   ⚠️  The .env file contains sensitive credentials and should remain local.
#   ⚠️  Verify that .env is listed in your .gitignore file.
#
# ============================================================================


# ----------------------------------------------------------------------------
# OpenAI Configuration (REQUIRED for most examples)
# ----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/account/api-keys
# Required by: retrieval_qa_chain.py, memory_enabled_chain.py, 
#              agent_with_tools.py, streaming_responses.py,
#              async_chain_execution.py, fallback_chains.py

OPENAI_API_KEY=your-openai-api-key-here

# Optional: Specify a different model (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-4

# Optional: Specify organization ID if you belong to multiple organizations
# OPENAI_ORGANIZATION_ID=org-your-organization-id


# ----------------------------------------------------------------------------
# Anthropic Configuration (OPTIONAL - for fallback examples)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/account/keys
# Required by: fallback_chains.py (when testing multi-provider fallbacks)

# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Specify a different model (default: claude-3-sonnet-20240229)
# ANTHROPIC_MODEL=claude-3-opus-20240229


# ----------------------------------------------------------------------------
# Vector Store Configuration (OPTIONAL - for RAG examples)
# ----------------------------------------------------------------------------
# Used by: retrieval_qa_chain.py
# Configures where Chroma vector database stores persistent data

# Optional: Directory for Chroma database persistence (default: ./chroma_db)
# CHROMA_PERSIST_DIRECTORY=./chroma_db

# Optional: Collection name for document storage
# CHROMA_COLLECTION_NAME=langchain_docs


# ----------------------------------------------------------------------------
# LangChain Tracing and Monitoring (OPTIONAL - for debugging)
# ----------------------------------------------------------------------------
# Enable LangSmith tracing to monitor and debug chain executions
# Get your API key from: https://smith.langchain.com/settings

# Enable LangSmith tracing (default: false)
# LANGCHAIN_TRACING_V2=false

# LangSmith API key (required if tracing is enabled)
# LANGCHAIN_API_KEY=your-langsmith-api-key-here

# Optional: Project name for organizing traces in LangSmith
# LANGCHAIN_PROJECT=advanced-chains-examples

# Optional: LangSmith API endpoint (default: https://api.smith.langchain.com)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ----------------------------------------------------------------------------
# General Application Settings
# ----------------------------------------------------------------------------

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Optional: Enable verbose output for debugging
# LANGCHAIN_VERBOSE=false


# ============================================================================
# Example-Specific Requirements
# ============================================================================
#
# retrieval_qa_chain.py:
#   - REQUIRED: OPENAI_API_KEY
#   - OPTIONAL: CHROMA_PERSIST_DIRECTORY, CHROMA_COLLECTION_NAME
#
# memory_enabled_chain.py:
#   - REQUIRED: OPENAI_API_KEY
#
# agent_with_tools.py:
#   - REQUIRED: OPENAI_API_KEY
#
# streaming_responses.py:
#   - REQUIRED: OPENAI_API_KEY
#
# async_chain_execution.py:
#   - REQUIRED: OPENAI_API_KEY
#
# fallback_chains.py:
#   - REQUIRED: OPENAI_API_KEY
#   - OPTIONAL: ANTHROPIC_API_KEY (for testing multi-provider fallbacks)
#
# ============================================================================
